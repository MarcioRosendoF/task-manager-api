<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.marcio</groupId>
	<artifactId>taskmanager</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>taskmanager</name>
	<description>Task Manager project</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.6.0</version>
		</dependency>

		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>uml</id>
			<build>
				<plugins>
					<plugin>
						<groupId>de.elnarion.maven</groupId>
						<artifactId>plantuml-generator-maven-plugin</artifactId>
						<version>3.0.1</version>
						<executions>
							<execution>
								<id>generate-uml-sources</id>
								<phase>process-classes</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<scanPackages>
										<scanPackage>com.marcio.taskmanager</scanPackage>
									</scanPackages>
									<outputDirectory>${project.build.directory}/plantuml</outputDirectory>
									<outputFilename>diagram.puml</outputFilename>
									<hideFields>false</hideFields>
									<hideMethods>false</hideMethods>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>com.github.davidmoten</groupId>
						<artifactId>plantuml-maven-plugin</artifactId>
						<version>0.2.14</version>
						<executions>
							<execution>
								<id>generate-uml-svg</id>
								<phase>process-classes</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<sources>
										<directory>${project.build.directory}/plantuml</directory>
										<includes>
											<include>diagram.puml</include>
										</includes>
									</sources>
									<outputDirectory>${project.basedir}/docs/diagrams</outputDirectory>
									<formats>
										<format>svg</format>
									</formats>
									<configs>
										<config>skinparam roundcorner 8</config>
										<config>skinparam shadowing false</config>
										<config>skinparam class {</config>
										<config>    BackgroundColor #FFFFFF</config>
										<config>    BorderColor #E2E8F0</config>
										<config>    HeaderBackgroundColor #F8FAFC</config>
										<config>    HeaderFontColor #0F172A</config>
										<config>    HeaderFontName "Inter"</config>
										<config>    HeaderFontSize 14</config>
										<config>    FontColor #334155</config>
										<config>    FontName "Inter"</config>
										<config>    FontSize 12</config>
										<config>    AttributeFontColor #475569</config>
										<config>    AttributeFontName "JetBrains Mono"</config>
										<config>    AttributeFontSize 10</config>
										<config>}</config>
										<config>skinparam stereotype {</config>
										<config>    FontColor #64748B</config>
										<config>    FontName "Inter"</config>
										<config>}</config>
										<config>skinparam arrow {</config>
										<config>    Color #94A3B8</config>
										<config>    Thickness 1.2</config>
										<config>}</config>
									</configs>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>

